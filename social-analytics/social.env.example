# Copiez ce fichier vers social-analytics/social.env sans le commiter.
# L'instance visée est exclusivement Switch développement sur pc-fixe.

# Doit être strictement identique à SOCIAL_PROXY_KEY dans
# social-gateway/gateway.env. Génération conseillée : openssl rand -base64 48
SOCIAL_PROXY_KEY=

# Clé persistante de 32 octets minimum. La changer rend les jetons OAuth déjà
# enregistrés illisibles. Génération conseillée : openssl rand -base64 48
SOCIAL_TOKEN_ENCRYPTION_KEY=

SOCIAL_PUBLIC_ORIGIN=https://pc-fixe-cst.tail3a8bdf.ts.net:10000
SOCIAL_TIMEZONE=Europe/Paris
SOCIAL_INITIAL_SYNC_DAYS=90
SOCIAL_SYNC_INTERVAL_MINUTES=360
SOCIAL_SCHEDULED_SYNC_ENABLED=true
SOCIAL_DEMO_MODE=false
SOCIAL_DEMO_SEED=false

# Instagram Business Login — compte professionnel Business ou Creator.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=https://pc-fixe-cst.tail3a8bdf.ts.net:10000/api/social/oauth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights
INSTAGRAM_ENABLE_FB_LOGIN=false
INSTAGRAM_FORCE_AUTHENTICATION=true

# TikTok Login Kit + Display API v2.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://pc-fixe-cst.tail3a8bdf.ts.net:10000/api/social/oauth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,user.info.profile,video.list

