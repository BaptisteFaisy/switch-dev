{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://switch.dev/schemas/agent-roles/v1/integration-record.schema.json",
  "title": "Controlled commit-lane compare-and-swap record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "integration_id",
    "branch",
    "order",
    "expected_head",
    "candidate_commit",
    "patch_sha256",
    "review_report_sha256",
    "test_artifact_sha256",
    "cas_result",
    "published_commit"
  ],
  "properties": {
    "schema_version": { "const": "integration-record/v1" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "integration_id": { "$ref": "#/$defs/identifier" },
    "branch": {
      "type": "string",
      "pattern": "^refs/heads/[A-Za-z0-9._/-]{1,240}$"
    },
    "order": { "type": "integer", "minimum": 0 },
    "expected_head": { "$ref": "#/$defs/commit" },
    "candidate_commit": { "$ref": "#/$defs/commit" },
    "patch_sha256": { "$ref": "#/$defs/sha256" },
    "review_report_sha256": { "$ref": "#/$defs/sha256" },
    "test_artifact_sha256": { "$ref": "#/$defs/sha256" },
    "cas_result": { "enum": ["advanced", "stale_head", "rejected"] },
    "published_commit": {
      "anyOf": [
        { "$ref": "#/$defs/commit" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "cas_result": { "const": "advanced" } },
        "required": ["cas_result"]
      },
      "then": { "properties": { "published_commit": { "$ref": "#/$defs/commit" } } },
      "else": { "properties": { "published_commit": { "type": "null" } } }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{7,64}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
