CST_BIND="0.0.0.0:8080"
CST_DATA_DIR="/srv/cst"
CST_WORKSPACES_ROOT="/srv/cst/workspaces"
CST_STATIC_DIR="/opt/codex-switch-terminal/dist"
CST_PUBLIC_BASE_URL={{ cst_public_base_url | to_json }}
CST_ALLOWED_ORIGINS={{ cst_public_base_url | to_json }}
CST_ADMIN_TOKEN={{ cst_admin_token | to_json }}
CST_GIT_PAT={{ cst_git_pat | default("") | to_json }}
CST_NODE_ID={{ cst_node_id | to_json }}
CST_NODE_LABEL={{ cst_node_label | to_json }}
# Compte special b.ai : cle DeepSeek (deepseek/deepseek-v4-flash, intensite max).
# Vide par defaut : le compte n'apparait que si cst_bai_api_key est renseigne.
CST_BAI_API_KEY={{ cst_bai_api_key | default("") | to_json }}
CST_NODE_CAPACITY={{ cst_capacity }}
{% if cst_gpu_transcription | default(false) | bool %}
CST_VOICE_TRANSCRIPTION_MODE="remote"
CST_VOICE_TRANSCRIPTION_URL="http://speaches:8000/v1/audio/transcriptions"
CST_VOICE_TRANSCRIPTION_MODEL={{ cst_transcription_model | to_json }}
CST_VOICE_TRANSCRIPTION_ACCELERATOR="gpu"
# HTTP est limite au reseau Docker prive ; aucun port Speaches n'est publie.
CST_VOICE_ALLOW_INSECURE_REMOTE="1"
{% endif %}
{% for name, value in (cst_extra_env | default({})).items() %}
{{ name }}={{ value | string | to_json }}
{% endfor %}
