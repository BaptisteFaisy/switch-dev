# TOPOLOGIE SWITCH : SSD/T7 ou pc-fixe = developpement uniquement.
# La version stable/production est hebergee sur le VPS Microsoft Azure.
# Ne jamais utiliser la copie SSD/locale comme cible stable.
CST_BIND=127.0.0.1:8080
CST_DATA_DIR=/srv/cst
# Optionnel : partage uniquement settings.json entre plusieurs instances.
# CST_ACCOUNTS_DIR=/srv/cst-shared-accounts
CST_STATIC_DIR=/opt/codex-switch-terminal/current/dist
# Regle d'acces (securite) : l'instance de developpement
# https://pc-fixe-cst.tail3a8bdf.ts.net/ est reservee au VPS Azure, seul tiers
# autorise a s'y connecter. Ne jamais publier le port applicatif sur Internet
# (pas de Tailscale Funnel, pas de CST_BIND=0.0.0.0 sur une URL publique).
CST_PUBLIC_BASE_URL=https://oracle-free-cst.YOUR_TAILNET.ts.net
CST_ALLOWED_ORIGINS=https://oracle-free-cst.YOUR_TAILNET.ts.net
CST_ADMIN_TOKEN=change-this-long-random-token
# Le premier compte peut toujours etre cree. Passe ensuite cette valeur a false
# pour fermer les inscriptions locales et la creation de nouveaux comptes Google.
CST_ALLOW_REGISTRATION=true
# Automatique avec une CST_PUBLIC_BASE_URL en https. A forcer seulement si le
# TLS est termine par un proxy dont l'URL publique n'est pas en https ci-dessus.
# CST_AUTH_SECURE_COOKIE=true
# OAuth Google (optionnel). Cree un client OAuth 2.0 de type "Application Web"
# et autorise exactement l'URI de redirection publique ci-dessous.
# CST_GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# CST_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# CST_GOOGLE_REDIRECT_URI=https://oracle-free-cst.YOUR_TAILNET.ts.net/api/auth/google/callback
# Microsoft 365 (optionnel) : Outlook et agenda dans le chat. Enregistre une
# application Entra ID, ajoute l'URI de redirection de type "Web" strictement
# identique a la ligne ci-dessous, puis accorde les permissions Graph deleguees.
# Les deux premieres valeurs vont ensemble ; les deux suivantes sont facultatives
# (tenant par defaut "common", redirection deduite de CST_PUBLIC_BASE_URL).
# Hors boucle locale la redirection doit etre en https, sinon l'integration se
# desactive au demarrage. Procedure detaillee : docs/microsoft-365.md.
# Orchestrations multi-agents : le pilotage est asynchrone (plusieurs threads
# font progresser les runs en parallele). CST_ORCHESTRATION_DRIVERS regle le
# nombre de threads (defaut 4, borne 1..=64) ; CST_ORCHESTRATION_WORKERS fixe le
# nombre de workers propose par defaut dans la vue Orchestration (defaut 3,
# paliers autorises 1, 2, 3, 4, 20, 100 ou 200) ;
# CST_ORCHESTRATION_CONCURRENCY borne le nombre total de tours d'agents en vol a
# travers toutes les orchestrations (defaut 8, borne 1..=200). C'est le reglage
# qui pilote la memoire du SSD quand on deploye 200 agents : chaque tour en vol
# est un agent qui code vraiment, les autres attendent leur tour.
# CST_ORCHESTRATION_DRIVERS=4
# CST_ORCHESTRATION_WORKERS=3
# CST_ORCHESTRATION_CONCURRENCY=8
# RAM-disk (tmpfs) pour les fichiers temporaires des agents : pointer
# CST_ORCHESTRATION_SANDBOX_DIR vers un montage tmpfs (ex. /dev/shm/cst-agents)
# pour y stocker les worktrees Git, clones et patches des agents, ~10x plus
# rapide que le SSD SATA. L'etat persiste (orchestrated-runs.json) reste sur le
# disque. Hors conteneur, creer d'abord le montage (voir deploy/ramdisk-agent-cache.sh).
# CST_ORCHESTRATION_SANDBOX_DIR=/dev/shm/cst-orchestrated-runs
#
# Compte special b.ai : une cle API DeepSeek (modele deepseek/deepseek-v4-flash,
# intensite de raisonnement max) fait apparaitre automatiquement le compte b.ai
# sur cette instance au prochain demarrage (fournisseur opencode, auth ecrite
# dans le home isole du compte). Laisser vide pour ne pas l'activer.
# CST_BAI_API_KEY=sk-...
#
# Etalement (stagger) des lancements d'agents autonomes pour lisser la charge
# sur une bande passante limitee (ms, valeur != 0 pour activer). Tant qu'un autre
# agent a deja un run en vol, chaque agent est retenu jusqu'a son creneau stable
# derive de son id (fenetre = valeur arrondie a la seconde, bornee 1..60 s).
# Inactif par defaut (0), ce qui conserve le comportement historique. Sur une
# connexion 10 Mbit/s, un reglage de 1000 a 2000 ms evite que toute la flotte
# demarre de front ; associez-le a CST_ORCHESTRATION_CONCURRENCY pour borner
# aussi le nombre de tours simultanes. Exemple :
# CST_AUTONOMOUS_AGENT_STAGGER_MS=1500
# Regulateur de bande passante dynamique : le serveur echantillonne le debit
# reseau reel (octets/s descendant + montant, via /proc/net/dev sur Linux et
# GetIfTable2 sur Windows) et retient les nouveaux lancements d'agents tant que
# le debit mesure depasse ce budget. A la difference du stagger (fixe), ce mode
# utilise le maximum disponible quand la ligne est libre et ne cale les
# lancements que pres de la saturation. Valeurs utiles pour 10 Mbit/s
# (≈ 1 250 000 octets/s) : reservez ~80 % de la ligne, soit ~1 000 000.
# Inactif (0) par defaut = comportement historique. Exemple :
# CST_AUTONOMOUS_BANDWIDTH_MAX_BYTES_S=1000000
# CST_MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
# CST_MICROSOFT_CLIENT_SECRET=replace-with-entra-client-secret
# CST_MICROSOFT_TENANT_ID=common
# CST_MICROSOFT_REDIRECT_URI=https://oracle-free-cst.YOUR_TAILNET.ts.net/api/microsoft/callback
# Facultatif aussi : ne changer que pour retirer une capacite au compte lie.
# CST_MICROSOFT_SCOPES=offline_access openid profile email User.Read Mail.Send Mail.Read Calendars.ReadWrite
# Notifications mobiles FCM (optionnel, alternative administree a la configuration dans l'app).
# Le fichier de compte de service reste hors du depot et hors de l'APK.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/cst-firebase-service-account.json
# CST_FIREBASE_PROJECT_ID=mon-projet-firebase
CST_GIT_PAT=
# Compte de secours du Studio IA image/video (optionnel). Garde cette cle uniquement sur le serveur.
# CST_FAL_KEY=key-id:key-secret
CST_NODE_ID=oracle-free
CST_NODE_LABEL=Oracle Free
CST_NODE_CAPACITY=1
# Voix sur navigateur/mobile (optionnel) : le serveur relaie le WAV vers des
# services GPU HTTPS. Ne publie jamais directement Ollama sur Internet.
# CST_VOICE_TRANSCRIPTION_MODE=remote
# CST_VOICE_TRANSCRIPTION_URL=https://gpu.example.net/stt/v1/audio/transcriptions
# CST_VOICE_TRANSCRIPTION_MODEL=Systran/faster-whisper-small
# CST_VOICE_TRANSCRIPTION_ACCELERATOR=gpu
# CST_VOICE_TRANSCRIPTION_API_KEY=replace-with-stt-token
# CST_VOICE_OLLAMA_URL=https://gpu.example.net/ollama
# CST_VOICE_OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# CST_VOICE_OLLAMA_API_KEY=replace-with-ollama-token
# Revolut Pay (optionnel) : accepter un paiement via la Merchant API Revolut.
# Le client Revolut Business doit activer Revolut Pay puis generer la Production
# API (public key = public_id cote client, secret key cote serveur). Les URLs de
# retour et de webhook deduites doivent etre declarees a l'identique chez Revolut
# et etre en HTTPS hors boucle locale. Procedure : docs/revolut-pay.md.
# Les deux valeurs vont ensemble : sans elles, l'integration est inactive.
# CST_REVOLUT_PUBLIC_KEY=replace-with-revolut-public-key
# CST_REVOLUT_SECRET_KEY=replace-with-revolut-secret-key
# Devise ISO par defaut d'un paiement (ex : EUR pour la France).
# CST_REVOLUT_CURRENCY=EUR
# Facultatif : "true" pour utiliser l'environnement sandbox de test de Revolut.
# CST_REVOLUT_SANDBOX=true
# CST_REVOLUT_MERCHANT_BASE_URL=https://sandbox-merchant.revolut.com
# Facultatif si CST_PUBLIC_BASE_URL est correcte :
# CST_REVOLUT_RETURN_URL=https://oracle-free-cst.YOUR_TAILNET.ts.net/api/revolut/return
# CST_REVOLUT_WEBHOOK_URL=https://oracle-free-cst.YOUR_TAILNET.ts.net/api/revolut/webhook
# Parrainage Duello (onglet Parrainage du dashboard, optionnel).
# CST_DUELLO_REFERRAL_API_URL : endpoint de l'application Duello qui renvoie le
# nombre de personnes parrainees par code. Contrat attendu :
#   GET {url}?codes=CODE1,CODE2  ->  { "referrals": { "CODE1": 3, "CODE2": 0 } }
# (les cles `codes` et, pour un code unique, `referralCount`/`count` sont aussi
# acceptees). Laisse vide tant que Duello n'expose pas cet endpoint : le
# dashboard affiche alors les codes avec le compteur "En attente".
# CST_DUELLO_REFERRAL_API_URL=https://app.duello.fr/api/referrals
# CST_DUELLO_REFERRAL_API_KEY=replace-with-duello-referral-token
# CST_DUELLO_APP_URL=https://app.duello.fr/

# Banque Duello (optionnel, serveur uniquement). Ne renseigner ces deux valeurs
# qu'apres validation du contrat prive `/api/admin/affiliate-wallets` +
# `/api/admin/affiliate-credits` sur l'environnement Duello vise. L'onglet reste
# volontairement en lecture seule/non configure si elles sont absentes.
# Le jeton est retire de l'environnement avant le lancement de tout terminal.
# CST_DUELLO_BANK_API_ORIGIN=https://duello-api.internal.example
# CST_DUELLO_BANK_ADMIN_TOKEN=replace-with-a-long-random-duello-admin-token
# Lien public affiche par Switch (HTTPS uniquement).
# CST_DUELLO_DASHBOARD_URL=https://duello.fr/dashboard
