# CST VPS scale profile: 20-30 connected sessions, 8 active agents.
# Apply only after a backup and a maintenance/drain check.
CST_NODE_CAPACITY=8
CST_CHAT_MAX_ACTIVE=8
CST_TERMINAL_CAPACITY=30
CST_CLAUDE_MAX_SESSIONS=8
CST_ORCHESTRATION_DRIVERS=4
CST_ORCHESTRATION_WORKERS=8
CST_ORCHESTRATION_CONCURRENCY=8
CST_CHAT_BUILD_JOBS=1
CST_TERMINAL_BUILD_JOBS=1
CST_CHAT_WORKER_THREADS=2
CST_TERMINAL_WORKER_THREADS=2
CST_CHAT_MIN_CONTAINER_HEADROOM_MIB=768
CST_CHAT_MIN_HOST_AVAILABLE_MIB=2048
CST_CHAT_NODE_HEAP_MIB=256
CST_TERMINAL_NODE_HEAP_MIB=256
CST_AUTONOMOUS_AGENT_STAGGER_MS=1500
CST_MEMORY_WATCHDOG_ENABLED=1
CST_MEMORY_WATCHDOG_CPU_PERCENT=85
CST_MEMORY_WATCHDOG_POLL_SECONDS=5
# Keep worktrees on persistent SSD; reserve tmpfs for small temporary files.
CST_ORCHESTRATION_SANDBOX_DIR=/srv/cst/agent-tmp
# PostgreSQL is intentionally staged separately; set these only after schema
# migration has been implemented and verified.
# CST_DATABASE_URL=postgresql://cst@postgres:5432/cst
