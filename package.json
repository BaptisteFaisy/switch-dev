{
  "name": "codex-switch-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite --host 127.0.0.1 --port 1420",
    "dev:server": "cargo run --manifest-path src-tauri/Cargo.toml --bin cst-server",
    "server:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-server.ps1",
    "server:local:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-server.ps1 -Build",
    "voice:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-voice.ps1",
    "voice:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/configure-remote-voice.ps1",
    "provision:oracle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/provision-oracle-free.ps1",
    "provision:google:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/enable-google-autoprovision.ps1",
    "check:vps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-vps-ready.ps1",
    "deploy:vps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-vps.ps1",
    "deploy:vps:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-vps-ansible.ps1",
    "update:vps:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-vps-from-github.ps1",
    "deploy:vps:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-vps.ps1",
    "deploy:vps:pool": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-vps-pool.ps1",
    "dockerize:git": "node public/skills/dockerize-git/scripts/dockerize-git.mjs",
    "connect:vps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-vps.ps1",
    "connect:vps:web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-vps-web.ps1",
    "connect:vps:web:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-vps-web.ps1 -Stop",
    "ssh:container:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-container-ssh.ps1",
    "container:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-container.ps1",
    "container:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-container.ps1",
    "connect:vps:pool": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/connect-vps-pool.ps1",
    "deploy:web:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-local-frontend.ps1",
    "web:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/open-web-interface.ps1",
    "web:local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-local-server.ps1",
    "clean": "node scripts/clean-build-artifacts.mjs all",
    "clean:web": "node scripts/clean-build-artifacts.mjs web",
    "clean:app": "node scripts/clean-build-artifacts.mjs app",
    "verify:versions": "node scripts/verify-versions.mjs",
    "verify:quick": "npm run verify:versions && npm run test:frontend",
    "verify:published-build": "node scripts/verify-published-build.mjs",
    "verify": "npm run verify:quick && cargo test --manifest-path src-tauri/Cargo.toml --all-targets --features desktop",
    "prebuild:source-guard": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-switch-build-source.ps1",
    "prebuild": "npm run prebuild:source-guard && npm run verify",
    "build": "npm run clean:app && node scripts/build-tauri-isolated.mjs --config src-tauri/tauri.local.conf.json",
    "prebuild:signed": "npm run prebuild:source-guard && npm run verify",
    "build:signed": "npm run clean:app && node scripts/build-tauri-isolated.mjs",
    "prebuild:frontend": "npm run prebuild:source-guard",
    "build:frontend": "npm run clean:web && tsc && vite build && node scripts/precompress-frontend.mjs",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:frontend:baseline": "node --test --test-concurrency=2 tests/*.test.mjs",
    "test:social": "node --test social-analytics/test/*.test.mjs social-gateway/test/*.test.mjs tests/social-view.test.mjs",
    "verify:resource-regression": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-server-resource-regression.ps1",
    "test:vps:ssh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-vps-ssh-tunnel.ps1",
    "test:smoke": "node scripts/smoke-site.mjs",
    "test:ios": "node --test tests/ios-client.test.mjs",
    "test:android": "node --test tests/android-client.test.mjs",
    "test:performance:mobile": "node --test tests/mobile-fluidity.test.mjs",
    "prebuild:android": "npm run prebuild:source-guard",
    "build:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-apk.ps1",
    "test:pwa": "node --test tests/pwa.test.mjs",
    "test:pwa:runtime": "npm run build:frontend && node scripts/test-pwa-runtime.mjs",
    "test:forum:runtime": "node scripts/test-forum-runtime.mjs",
    "test:messaging:runtime": "node scripts/test-private-messaging-runtime.mjs",
    "test:video:runtime": "node scripts/test-video-generation-runtime.mjs",
    "test:update-runtime": "node scripts/test-update-node-runtime.mjs",
    "test:update-windows-concurrency-runtime": "node scripts/test-update-node-runtime.mjs --concurrency-only",
    "test:update-linux-runtime": "node scripts/test-update-node-linux-runtime.mjs",
    "test:update-linux-concurrency-runtime": "node scripts/test-update-node-linux-runtime.mjs test-update-node-linux-concurrency-runtime.sh",
    "prebuild:server": "npm run prebuild:source-guard && npm run verify",
    "build:server": "cargo build --manifest-path src-tauri/Cargo.toml --release --bin cst-server",
    "preview": "vite preview"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lucide": "^0.468.0",
    "playwright-core": "^1.61.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.3"
  }
}
